<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:padding="16dp">

	<TextView
		android:id="@+id/lightshowStatusText"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:text="Import and mark a track first."
		android:textSize="15sp" />

	<TextView
		android:id="@+id/lightshowRowLabel"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="8dp"
		android:text="Chain:"
		android:textSize="12sp"
		android:textStyle="bold" />

	<LinearLayout
		android:id="@+id/lightshowButtonRow"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="4dp"
		android:orientation="horizontal" />

	<!-- Edit-mode-only controls: time/duration steppers, play/stop/save/back. Hidden
	     entirely in overview mode (nothing selected yet). -->
	<LinearLayout
		android:id="@+id/lightshowEditControls"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="8dp"
		android:orientation="vertical"
		android:visibility="gone">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			android:gravity="center_vertical">

			<TextView
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:id="@+id/lightshowVelocityText"
				android:text="Velocity: 0"
				android:textSize="13sp" />
			<Button android:id="@+id/lightshowVelocityMinus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-1" android:textSize="11sp" android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" />
			<Button android:id="@+id/lightshowVelocityPlus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+1" android:textSize="11sp" android:minWidth="0dp" android:paddingStart="8dp" android:paddingEnd="8dp" />
		</LinearLayout>

		<TextView
			android:id="@+id/lightshowTimeText"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:text="Time: 0ms"
			android:textSize="13sp"
			android:textStyle="bold" />

		<!-- Pad -> Lights -> Time: tap pads on the grid to light them at the current
		     Time, then dial Time in with these. No duration/staging step: a pad tap
		     places immediately using FIXED_DURATION_MS. -->
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="4dp"
			android:orientation="horizontal">

			<Button android:id="@+id/lightshowTimeMinus1000" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="-1000" android:textSize="9sp" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" />
			<Button android:id="@+id/lightshowTimeMinus100" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="-100" android:textSize="9sp" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" />
			<Button android:id="@+id/lightshowTimeMinus10" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="-10" android:textSize="9sp" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" />
			<Button android:id="@+id/lightshowTimeMinus1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="-1" android:textSize="9sp" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" />
			<Button android:id="@+id/lightshowTimePlus1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="+1" android:textSize="9sp" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" />
			<Button android:id="@+id/lightshowTimePlus10" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="+10" android:textSize="9sp" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" />
			<Button android:id="@+id/lightshowTimePlus100" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="+100" android:textSize="9sp" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" />
			<Button android:id="@+id/lightshowTimePlus1000" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="+1000" android:textSize="9sp" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" />
		</LinearLayout>

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:orientation="horizontal">

			<Button android:id="@+id/lightshowPlay" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Play" android:textSize="12sp" />
			<Button android:id="@+id/lightshowStop" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Stop" android:textSize="12sp" />
			<Button android:id="@+id/lightshowSave" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Save" android:textSize="12sp" />
			<Button android:id="@+id/lightshowBack" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Back" android:textSize="12sp" />
		</LinearLayout>
	</LinearLayout>

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="12dp"
		android:text="Events:"
		android:textSize="12sp"
		android:textStyle="bold" />

	<ScrollView
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:background="#1A1A2E"
		android:layout_marginTop="4dp">

		<LinearLayout
			android:id="@+id/lightshowEventListContainer"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:padding="8dp" />

	</ScrollView>

	<com.bobbypfreely.lpbf.ui.VirtualLaunchpadGridView
		android:id="@+id/lightshowGrid"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="2"
		android:layout_marginTop="12dp"
		android:background="#0F0F1A" />

</LinearLayout>
