<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:padding="8dp">

	<TextView
		android:id="@+id/lightshowStatusText"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:text="Import and mark a track first."
		android:textColor="#DDDDDD"
		android:textSize="12sp" />

	<TextView
		android:id="@+id/lightshowRowLabel"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="6dp"
		android:text="Chain:"
		android:textColor="#AAAAAA"
		android:textSize="11sp"
		android:textStyle="bold" />

	<!-- Color slots when editing a cut; chain numbers otherwise -->
	<LinearLayout
		android:id="@+id/lightshowButtonRow"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="2dp"
		android:orientation="horizontal" />

	<!-- Slim transport only — no time/velocity strip -->
	<LinearLayout
		android:id="@+id/lightshowEditControls"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="6dp"
		android:orientation="horizontal"
		android:visibility="gone">

		<Button
			android:id="@+id/lightshowPlay"
			android:layout_width="0dp"
			android:layout_height="40dp"
			android:layout_weight="1"
			android:text="Play"
			android:textSize="11sp" />
		<Button
			android:id="@+id/lightshowStop"
			android:layout_width="0dp"
			android:layout_height="40dp"
			android:layout_weight="1"
			android:text="Stop"
			android:textSize="11sp" />
		<Button
			android:id="@+id/lightshowSave"
			android:layout_width="0dp"
			android:layout_height="40dp"
			android:layout_weight="1"
			android:text="Save"
			android:textSize="11sp" />
		<Button
			android:id="@+id/lightshowBack"
			android:layout_width="0dp"
			android:layout_height="40dp"
			android:layout_weight="1"
			android:text="Back"
			android:textSize="11sp" />
	</LinearLayout>

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="8dp"
		android:text="Events (tap to edit, long-press remove):"
		android:textColor="#AAAAAA"
		android:textSize="11sp"
		android:textStyle="bold" />

	<ScrollView
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:background="#1A1A2E"
		android:layout_marginTop="4dp">

		<LinearLayout
			android:id="@+id/lightshowEventListContainer"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:padding="6dp" />
	</ScrollView>

	<!-- Hidden: paint/target is the main Launchpad in MainActivity -->
	<com.bobbypfreely.lpbf.ui.VirtualLaunchpadGridView
		android:id="@+id/lightshowGrid"
		android:layout_width="0dp"
		android:layout_height="0dp"
		android:visibility="gone" />

</LinearLayout>