<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#070711"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/placeStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Import and mark a track first."
        android:textColor="#E9E9F5"
        android:textSize="13sp"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="#101021" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/placeModeToggle"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:text="Mode: Edit"
            android:textSize="12sp"
            android:minHeight="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="CHAIN"
            android:textColor="#77778C"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/chainSelectorRow"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#0D0D1B" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="LAUNCHPAD"
        android:textColor="#6E6E84"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.12" />

    <com.bobbypfreely.lpbf.ui.VirtualLaunchpadGridView
        android:id="@+id/placeGrid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5"
        android:layout_marginTop="3dp"
        android:background="#070711"
        android:contentDescription="Virtual Launchpad" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:layout_marginTop="7dp"
        android:orientation="vertical"
        android:background="#0D0D1B">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="9dp"
            android:paddingTop="5dp"
            android:paddingBottom="3dp"
            android:text="CUTS"
            android:textColor="#6E6E84"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/segmentListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingBottom="5dp" />
        </ScrollView>
    </LinearLayout>

</LinearLayout>
