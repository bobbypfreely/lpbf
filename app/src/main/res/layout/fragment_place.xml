<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:padding="16dp">

	<TextView
		android:id="@+id/placeStatusText"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:text="Import and mark a track first."
		android:textSize="15sp" />

	<Button
		android:id="@+id/placeModeToggle"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="8dp"
		android:text="Mode: Edit" />

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="8dp"
		android:text="Chain:"
		android:textSize="12sp"
		android:textStyle="bold" />

	<LinearLayout
		android:id="@+id/chainSelectorRow"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="4dp"
		android:orientation="horizontal" />

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="12dp"
		android:text="Cuts:"
		android:textSize="12sp"
		android:textStyle="bold" />

	<ScrollView
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:background="#1A1A2E"
		android:layout_marginTop="4dp">

		<LinearLayout
			android:id="@+id/segmentListContainer"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:padding="8dp" />

	</ScrollView>

	<com.bobbypfreely.lpbf.ui.VirtualLaunchpadGridView
		android:id="@+id/placeGrid"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="2"
		android:layout_marginTop="12dp"
		android:background="#0F0F1A" />

</LinearLayout>
