<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:padding="8dp">

	<HorizontalScrollView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:scrollbars="none">
		<LinearLayout
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			android:layout_gravity="center_horizontal">
			<Button android:id="@+id/importButton" android:layout_width="wrap_content" android:layout_height="36dp" android:text="Import" android:textSize="12sp" android:minWidth="0dp" android:paddingStart="12dp" android:paddingEnd="12dp" />
			<Button android:id="@+id/importPreCutButton" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="4dp" android:text="Pre-Cut" android:textSize="12sp" android:minWidth="0dp" android:paddingStart="12dp" android:paddingEnd="12dp" />
			<Button android:id="@+id/importUnipackButton" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="4dp" android:text="Unipack" android:textSize="12sp" android:minWidth="0dp" android:paddingStart="12dp" android:paddingEnd="12dp" />
			<Button android:id="@+id/importUnipackFolderButton" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="4dp" android:text="Folder" android:textSize="12sp" android:minWidth="0dp" android:paddingStart="12dp" android:paddingEnd="12dp" />
			<Button android:id="@+id/saveProjectButton" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="4dp" android:text="Save" android:textSize="12sp" android:minWidth="0dp" android:paddingStart="12dp" android:paddingEnd="12dp" />
			<Button android:id="@+id/loadProjectButton" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginStart="4dp" android:text="Load" android:textSize="12sp" android:minWidth="0dp" android:paddingStart="12dp" android:paddingEnd="12dp" />
		</LinearLayout>
	</HorizontalScrollView>

	<TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Import a track to begin." android:textSize="12sp" android:textColor="#CCCCDD" android:maxLines="2" android:gravity="center_horizontal" />
	<TextView android:id="@+id/connectionText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No Launchpad connected" android:textSize="11sp" android:textColor="#8888AA" android:gravity="center_horizontal" />

	<FrameLayout
		android:id="@+id/waveformContainer"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_marginTop="6dp"
		android:layout_marginStart="8dp"
		android:layout_marginEnd="8dp"
		android:layout_weight="1"
		android:minHeight="120dp"
		android:background="#0F0F1A">
		<com.bobbypfreely.lpbf.waveform.WaveformView
			android:id="@+id/waveformView"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:layout_gravity="center" />
		<com.bobbypfreely.lpbf.waveform.MarkOverlayView
			android:id="@+id/markOverlay"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:layout_gravity="center" />
	</FrameLayout>

	<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:orientation="horizontal" android:gravity="center_vertical">
		<Button android:id="@+id/restartButton" android:layout_width="40dp" android:layout_height="36dp" android:text="R" android:textSize="12sp" />
		<SeekBar android:id="@+id/playbackSeekBar" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="4dp" />
	</LinearLayout>

	<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:orientation="horizontal">
		<Button android:id="@+id/zoomOutButton" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:text="- Zoom" android:textSize="12sp" />
		<Button android:id="@+id/playPauseButton" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="2" android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:text="Play" android:textSize="13sp" />
		<Button android:id="@+id/zoomInButton" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:text="+ Zoom" android:textSize="12sp" />
	</LinearLayout>

	<Button android:id="@+id/dropMarkButton" android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="4dp" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:text="Mark Cut Here" android:textSize="13sp" />

	<ScrollView android:id="@+id/debugScroll" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:background="#1A1A2E">
		<TextView android:id="@+id/debugLog" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="4dp" android:fontFamily="monospace" android:textColor="#00ADB5" android:textIsSelectable="true" android:textSize="10sp" />
	</ScrollView>
</LinearLayout>
