<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical"
	android:padding="8dp">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:gravity="center_vertical">

		<Button
			android:id="@+id/menuButton"
			android:layout_width="wrap_content"
			android:layout_height="36dp"
			android:text="Menu"
			android:textSize="12sp"
			android:minWidth="0dp"
			android:paddingStart="14dp"
			android:paddingEnd="14dp" />

		<TextView
			android:id="@+id/statusText"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:layout_marginStart="8dp"
			android:text="Menu → New project to begin."
			android:textSize="12sp"
			android:textColor="#CCCCDD"
			android:maxLines="2" />
	</LinearLayout>

	<TextView
		android:id="@+id/connectionText"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="2dp"
		android:text="No Launchpad connected"
		android:textSize="11sp"
		android:textColor="#8888AA"
		android:gravity="center_horizontal" />

	<FrameLayout
		android:id="@+id/waveformContainer"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:layout_marginTop="4dp"
		android:background="#0F0F1A">

		<com.bobbypfreely.lpbf.waveform.WaveformView
			android:id="@+id/waveformView"
			android:layout_width="match_parent"
			android:layout_height="match_parent" />

		<com.bobbypfreely.lpbf.waveform.MarkOverlayView
			android:id="@+id/markOverlay"
			android:layout_width="match_parent"
			android:layout_height="match_parent" />
	</FrameLayout>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="4dp"
		android:layout_marginStart="8dp"
		android:layout_marginEnd="8dp"
		android:orientation="horizontal"
		android:gravity="center_vertical">

		<Button
			android:id="@+id/restartButton"
			android:layout_width="40dp"
			android:layout_height="36dp"
			android:text="R"
			android:textSize="12sp" />

		<SeekBar
			android:id="@+id/playbackSeekBar"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:layout_marginStart="4dp" />

		<TextView
			android:id="@+id/waveformTimeText"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginStart="6dp"
			android:minWidth="88dp"
			android:gravity="end"
			android:fontFamily="monospace"
			android:text="0:00 / 0:00"
			android:textSize="12sp"
			android:textColor="#E0E0F0" />
	</LinearLayout>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="4dp"
		android:layout_marginStart="8dp"
		android:layout_marginEnd="8dp"
		android:orientation="horizontal">

		<Button
			android:id="@+id/zoomOutButton"
			android:layout_width="0dp"
			android:layout_height="36dp"
			android:layout_weight="1"
			android:text="- Zoom"
			android:textSize="12sp" />

		<Button
			android:id="@+id/playPauseButton"
			android:layout_width="0dp"
			android:layout_height="36dp"
			android:layout_weight="2"
			android:layout_marginStart="4dp"
			android:layout_marginEnd="4dp"
			android:text="Play"
			android:textSize="13sp" />

		<Button
			android:id="@+id/zoomInButton"
			android:layout_width="0dp"
			android:layout_height="36dp"
			android:layout_weight="1"
			android:text="+ Zoom"
			android:textSize="12sp" />
	</LinearLayout>

	<Button
		android:id="@+id/dropMarkButton"
		android:layout_width="match_parent"
		android:layout_height="40dp"
		android:layout_marginTop="4dp"
		android:layout_marginStart="8dp"
		android:layout_marginEnd="8dp"
		android:text="Mark Cut Here"
		android:textSize="13sp" />

	<ScrollView
		android:id="@+id/debugScroll"
		android:layout_width="match_parent"
		android:layout_height="48dp"
		android:layout_marginTop="4dp"
		android:layout_marginStart="8dp"
		android:layout_marginEnd="8dp"
		android:background="#1A1A2E">

		<TextView
			android:id="@+id/debugLog"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:padding="4dp"
			android:fontFamily="monospace"
			android:textColor="#00ADB5"
			android:textIsSelectable="true"
			android:textSize="10sp" />
	</ScrollView>
</LinearLayout>