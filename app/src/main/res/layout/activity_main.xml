<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/rootCoordinator"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="#0B0B12">

	<FrameLayout
		android:id="@+id/centerPadContainer"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:layout_marginStart="56dp"
		android:layout_marginEnd="56dp"
		android:layout_marginTop="8dp"
		android:layout_marginBottom="56dp"
		android:padding="4dp">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:orientation="vertical">

			<!-- Mode bar: label + hybrid cog (main) -->
			<LinearLayout
				android:id="@+id/modeBar"
				android:layout_width="match_parent"
				android:layout_height="36dp"
				android:orientation="horizontal"
				android:gravity="center_vertical"
				android:paddingStart="8dp"
				android:paddingEnd="8dp">
				<TextView
					android:id="@+id/modeLabel"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:text="PLAY"
					android:textColor="#00ADB5"
					android:textSize="13sp"
					android:textStyle="bold"
					android:letterSpacing="0.06" />
				<TextView
					android:id="@+id/btnModeHybrid"
					android:layout_width="40dp"
					android:layout_height="36dp"
					android:gravity="center"
					android:text="⚙"
					android:textColor="#E0E0FF"
					android:textSize="20sp"
					android:contentDescription="Hybrid mode"
					android:background="?attr/selectableItemBackgroundBorderless"
					android:clickable="true"
					android:focusable="true" />
			</LinearLayout>

			<com.bobbypfreely.lpbf.ui.VirtualLaunchpadGridView
				android:id="@+id/mainLaunchpadGrid"
				android:layout_width="match_parent"
				android:layout_height="0dp"
				android:layout_weight="1"
				android:background="#0B0B12" />
		</LinearLayout>
	</FrameLayout>

	<LinearLayout
		android:id="@+id/leftPillHandle"
		android:layout_width="48dp"
		android:layout_height="140dp"
		android:layout_gravity="start|center_vertical"
		android:layout_marginStart="4dp"
		android:orientation="vertical"
		android:gravity="center"
		android:background="#1A1A2E"
		android:elevation="24dp"
		android:clickable="true"
		android:focusable="true">
		<TextView
			android:id="@+id/leftPillLabel"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="LED"
			android:textColor="#E0E0FF"
			android:textSize="12sp"
			android:textStyle="bold"
			android:rotation="-90" />
	</LinearLayout>

	<LinearLayout
		android:id="@+id/leftDrawer"
		android:layout_width="240dp"
		android:layout_height="match_parent"
		android:layout_gravity="start"
		android:orientation="vertical"
		android:background="#12121C"
		android:elevation="16dp"
		android:visibility="gone"
		android:padding="12dp"
		android:clickable="true"
		android:focusable="true">
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			android:gravity="center_vertical">
			<TextView
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="KeyLED"
				android:textColor="#FFFFFF"
				android:textSize="18sp"
				android:textStyle="bold" />
			<TextView
				android:id="@+id/btnModeLights"
				android:layout_width="40dp"
				android:layout_height="40dp"
				android:gravity="center"
				android:text="⚙"
				android:textColor="#E0E0FF"
				android:textSize="20sp"
				android:contentDescription="Lights edit mode"
				android:background="?attr/selectableItemBackgroundBorderless"
				android:clickable="true"
				android:focusable="true" />
			<TextView
				android:id="@+id/btnCloseLeft"
				android:layout_width="40dp"
				android:layout_height="40dp"
				android:gravity="center"
				android:text="✕"
				android:textColor="#CCCCDD"
				android:textSize="18sp"
				android:background="?attr/selectableItemBackgroundBorderless"
				android:clickable="true"
				android:focusable="true" />
		</LinearLayout>
		<TextView
			android:id="@+id/lightsModeHint"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="Tap ⚙ for lights edit. Top-row Left also enters lights."
			android:textColor="#8888AA"
			android:textSize="11sp"
			android:paddingBottom="6dp" />
		<FrameLayout
			android:id="@+id/lightshowPlaceholder"
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_weight="1"
			android:background="#0A0A12" />
		<ScrollView
			android:id="@+id/ledListScroll"
			android:layout_width="match_parent"
			android:layout_height="80dp"
			android:background="#0A0A12">
			<TextView
				android:id="@+id/ledFolderSummary"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:text="(no LED patterns yet)"
				android:textColor="#A0A0CC"
				android:textSize="12sp"
				android:fontFamily="monospace" />
		</ScrollView>
		<EditText
			android:id="@+id/ledEditor"
			android:layout_width="match_parent"
			android:layout_height="72dp"
			android:layout_marginTop="4dp"
			android:background="#0A0A12"
			android:gravity="top|start"
			android:hint="LED list"
			android:textColor="#CCE0FF"
			android:textColorHint="#445566"
			android:padding="8dp"
			android:textSize="12sp"
			android:fontFamily="monospace"
			android:inputType="textMultiLine" />
	</LinearLayout>

	<LinearLayout
		android:id="@+id/rightPillHandle"
		android:layout_width="48dp"
		android:layout_height="140dp"
		android:layout_gravity="end|center_vertical"
		android:layout_marginEnd="4dp"
		android:orientation="vertical"
		android:gravity="center"
		android:background="#1A1A2E"
		android:elevation="24dp"
		android:clickable="true"
		android:focusable="true">
		<TextView
			android:id="@+id/rightPillLabel"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="SOUND"
			android:textColor="#E0FFE0"
			android:textSize="12sp"
			android:textStyle="bold"
			android:rotation="90" />
	</LinearLayout>

	<LinearLayout
		android:id="@+id/rightDrawer"
		android:layout_width="240dp"
		android:layout_height="match_parent"
		android:layout_gravity="end"
		android:orientation="vertical"
		android:background="#12121C"
		android:elevation="16dp"
		android:visibility="gone"
		android:padding="12dp"
		android:clickable="true"
		android:focusable="true">
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			android:gravity="center_vertical">
			<TextView
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="KeySound"
				android:textColor="#FFFFFF"
				android:textSize="18sp"
				android:textStyle="bold" />
			<TextView
				android:id="@+id/btnModeMap"
				android:layout_width="40dp"
				android:layout_height="40dp"
				android:gravity="center"
				android:text="⚙"
				android:textColor="#E0FFE0"
				android:textSize="20sp"
				android:contentDescription="Map / edit mode"
				android:background="?attr/selectableItemBackgroundBorderless"
				android:clickable="true"
				android:focusable="true" />
			<TextView
				android:id="@+id/btnCloseRight"
				android:layout_width="40dp"
				android:layout_height="40dp"
				android:gravity="center"
				android:text="✕"
				android:textColor="#CCCCDD"
				android:textSize="18sp"
				android:background="?attr/selectableItemBackgroundBorderless"
				android:clickable="true"
				android:focusable="true" />
		</LinearLayout>
		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:text="⚙ enters map (EDIT). Top-row Down also maps."
			android:textColor="#8888AA"
			android:textSize="11sp"
			android:paddingBottom="6dp" />
		<ScrollView
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_weight="1"
			android:background="#0A0A12">
			<TextView
				android:id="@+id/soundFolderSummary"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:text="(no mappings yet)"
				android:textColor="#A0CCA0"
				android:textSize="12sp"
				android:fontFamily="monospace" />
		</ScrollView>
		<EditText
			android:id="@+id/soundEditor"
			android:layout_width="match_parent"
			android:layout_height="100dp"
			android:layout_marginTop="6dp"
			android:background="#0A0A12"
			android:gravity="top|start"
			android:hint="Sound mapping"
			android:textColor="#CCFFCC"
			android:textColorHint="#445566"
			android:padding="8dp"
			android:textSize="12sp"
			android:fontFamily="monospace"
			android:inputType="textMultiLine" />
		<Button
			android:id="@+id/btnExportUnipack"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="8dp"
			android:text="Export Unipack" />
	</LinearLayout>

	<LinearLayout
		android:id="@+id/bottomPillHandle"
		android:layout_width="160dp"
		android:layout_height="44dp"
		android:layout_gravity="bottom|center_horizontal"
		android:layout_marginBottom="8dp"
		android:orientation="horizontal"
		android:gravity="center"
		android:background="#1A1A2E"
		android:elevation="24dp"
		android:clickable="true"
		android:focusable="true">
		<TextView
			android:id="@+id/bottomPillLabel"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="WAVEFORM"
			android:textColor="#FFE0E0"
			android:textSize="12sp"
			android:textStyle="bold"
			android:letterSpacing="0.08" />
	</LinearLayout>

	<LinearLayout
		android:id="@+id/bottomDrawer"
		android:layout_width="match_parent"
		android:layout_height="320dp"
		android:layout_gravity="bottom"
		android:orientation="vertical"
		android:background="#12121C"
		android:elevation="18dp"
		android:visibility="gone"
		android:padding="8dp"
		android:clickable="true"
		android:focusable="true">
		<View
			android:layout_width="40dp"
			android:layout_height="4dp"
			android:layout_gravity="center_horizontal"
			android:background="#444466"
			android:layout_marginBottom="6dp" />
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			android:gravity="center_vertical">
			<TextView
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:text="Waveform / Mark & Cut"
				android:textColor="#FFFFFF"
				android:textSize="14sp"
				android:textStyle="bold" />
			<TextView
				android:id="@+id/btnCloseBottom"
				android:layout_width="40dp"
				android:layout_height="40dp"
				android:gravity="center"
				android:text="✕"
				android:textColor="#CCCCDD"
				android:textSize="18sp"
				android:background="?attr/selectableItemBackgroundBorderless"
				android:clickable="true"
				android:focusable="true" />
		</LinearLayout>
		<FrameLayout
			android:id="@+id/waveformPlaceholder"
			android:layout_width="match_parent"
			android:layout_height="0dp"
			android:layout_weight="1"
			android:background="#0F0F1A" />
	</LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
