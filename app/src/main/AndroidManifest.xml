<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:tools="http://schemas.android.com/tools">

	<uses-feature
		android:name="android.hardware.usb.host"
		android:required="false" />

	<application
		android:allowBackup="true"
		android:icon="@mipmap/ic_launcher"
		android:label="@string/app_name"
		android:supportsRtl="true"
		android:theme="@style/Theme.LPBF">

		<activity
			android:name=".MainActivity"
			android:exported="true">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity>

		<!-- No-UI activity that catches a physical Launchpad being plugged in via USB
		     and hands it to MidiConnection, ported from Unipad's identical pattern. -->
		<activity
			android:name=".activity.UsbMidiHandlerActivity"
			android:exported="true"
			android:launchMode="singleInstance"
			android:theme="@android:style/Theme.NoDisplay"
			android:noHistory="true"
			tools:ignore="DiscouragedApi">
			<intent-filter>
				<action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
			</intent-filter>

			<meta-data
				android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
				android:resource="@xml/device_filter" />
		</activity>

	</application>

</manifest>
